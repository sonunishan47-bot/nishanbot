# Copy this file to .env for local overrides.
# No API keys are required for the default CoinGecko + FX + Ollama setup.

LLM_PROVIDER=ollama
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2
# OLLAMA_API_MODE=generate
# OLLAMA_NUM_CTX=4096

MAX_RESPONSE_TOKENS=1024
CHAT_HISTORY_TURNS=6
LLM_TEMPERATURE=0.2

# Groq (OpenAI-compatible). Uncomment and set a key to use LLM_PROVIDER=groq
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible APIs
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Phase 7 optional keys (RSS works with no keys)
# NEWS_API_KEY=
# CRYPTOPANIC_API_KEY=
# CRYPTOPANIC_KEY=
# FRED_API_KEY=
# TOR_ENABLED=true
# TOR_PROXY=socks5h://127.0.0.1:9050
